import m1
import m2
import m3

def main():

    while True:

        print("\n==============================================")
        print("       ATTANDANCE MANAGEMENT")
        print("==============================================")

        print("1. Student Management")
        print("2. Attandance Management")
        print("3. Attandance Analysis")
        print("4. Exit")

        choice = input("\nEnter your choice: ")

        if choice == "1":

            while True:

                print("\n---------- STUDENT MANAGEMENT ----------")
                print("1. Add Student")
                print("2. Remove Student")
                print("3. Search Student")
                print("4. View All Students")
                print("5. Back to Main Menu")

                option = input("\nEnter your choice: ")

                if option == "1":
                    m1.add_student(students)

                elif option == "2":
                    m1.remove_student(students)

                elif option == "3":
                    m1.search_student(students)

                elif option == "4":
                    m1.view_students(students)

                elif option == "5":
                    for student_id, name in students.items():
                        attendance[name] = []
                    break

                else:
                    print("Invalid choice. Please try again.")

        elif choice == "2":

            while True:

                print("\n---------- Attandance MANAGEMENT ----------")
                print("1. Mark Present")
                print("2. Mark Absent")
                print("3. View Attendance")
                print("4. Back to Main Menu")

                option = input("\nEnter your choice: ")

                if option == "1":
                    m2.mark_present(attendance)

                elif option == "2":
                    m2.mark_absent(attendance)

                elif option == "3":
                    m2.view_attendance(attendance)

                elif option == "4":
                    break

                else:
                    print("Invalid choice. Please try again.")

        elif choice == "3":

            while True:

                print("\n---------- Attandance Analysis ----------")
                print("1. Attandance Percentage")
                print("2. Check Eligibility")
                print("3. Highest Attendance")
                print("4. Lowest Attendance")
                print("5. Back to Main Menu")

                option = input("\nEnter your choice: ")

                if option == "1":
                    m3.at_percent(attendance)

                elif option == "2":
                    m3.analyze_attendance(attendance)

                elif option == "3":
                    m3.highest_attendance(attendance)

                elif option == "4":
                    m3.lowest_attendance(attendance)

                elif option == "5":
                    break

                else:
                    print("Invalid choice. Please try again.")

        elif choice == "4":

            print("\nTHANK YOU")
            break

        else:

            print("\nInvalid choice. Please enter 1, 2, 3 or 4.")

students={}
attendance={}
main()
